  "author": "Kuchto47 <martin.k738@gmail.com>",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "prettier --write \"**/*.{js,ts,vue,css,html,md,json}\" --ignore-path .gitignore && eslint --fix -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\"",
    "lint:check": "prettier \"**/*.{js,ts,vue,css,html,md,json}\" --ignore-path .gitignore && eslint -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\"",
    "dev": "quasar dev",
    "build": "quasar build",
    "typecheck": "vue-tsc --noEmit",
    "postinstall": "quasar prepare --silent"
  },
  "dependencies": {
    "@quasar/extras": "2.0.2",
    "@trpc/client": "11.18.0",
    "quasar": "2.23.1",
    "vue": "3.5.40",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@quasar/app-vite": "3.2.0",
    "@types/node": "22.20.1",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.9.0",
    "autoprefixer": "10.5.4",
    "eslint": "9.39.5",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.7.0",
    "postcss": "8.5.22",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "vite-plugin-checker": "0.12.0",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.8"
  },
  "keywords": [
    "quasar",
    "quasar-app",
    "quasar-cli",
    "quasar-app-vite",
    "vite",
    "vue",
    "vuejs"
  ],
  "engines": {
    "node": ">= 26 || ^24 || ^22.12"
  }
